{
  "name": "better-auth-audit",
  "version": "1.4.0",
  "description": "Audit log plugin for Better Auth",
  "keywords": [
    "better-auth",
    "better-auth-plugin",
    "audit-log",
    "audit-trail",
    "authentication",
    "security"
  ],
  "homepage": "https://github.com/TheUntraceable/better-auth-audit#readme",
  "bugs": {
    "url": "https://github.com/TheUntraceable/better-auth-audit/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TheUntraceable/better-auth-audit.git"
  },
  "author": "TheUntraceable",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./client": {
      "import": {
        "types": "./dist/client.d.ts",
        "default": "./dist/client.js"
      },
      "require": {
        "types": "./dist/client.d.cts",
        "default": "./dist/client.cjs"
      }
    }
  },
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepublishOnly": "bun run typecheck && bun run test && bun run build"
  },
  "engines": {
    "node": ">=22.16.0"
  },
  "peerDependencies": {
    "better-auth": "^1.5.0",
    "zod": "^3.0.0 || ^4.0.0"
  },
  "devDependencies": {
    "better-auth": "1.7.5",
    "tsup": "^8.0.0",
    "typescript": "^5.0.0",
    "vitest": "^4.1.0",
    "zod": "^4.2.1"
  },
  "license": "MIT"
}
